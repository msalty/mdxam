{
  "id": "./",
  "name": "MDXam · Markdown Practice Exams",
  "short_name": "MDXam",
  "description": "Turn Markdown study guides into private, offline practice exams.",
  "lang": "en-US",
  "start_url": "./#exams",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f5f7fb",
  "theme_color": "#172554",
  "categories": ["education", "productivity", "utilities"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "My exams",
      "short_name": "Exams",
      "url": "./#exams",
      "icons": [{ "src": "./icons/exams-64.png", "sizes": "256x256", "type": "image/png" }]
    },
    {
      "name": "Add an exam",
      "short_name": "Add exam",
      "url": "./#import",
      "icons": [{ "src": "./icons/upload-file-64.png", "sizes": "256x256", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "./#import",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/plain": [".txt"]
      }
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
